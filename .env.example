# Admin Password for Keystatic CMS (/keystatic)
ADMIN_PASSWORD=your_secure_password_here

# Optional: Vercel KV / Upstash Redis for 100% Persistent Analytics on Vercel
# (Automatically populated if you add "Storage -> KV" in your Vercel Dashboard)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Resend API Key for Newsletter Audience
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# Optional: Keystatic GitHub App credentials for Cloud Mode on Vercel
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
